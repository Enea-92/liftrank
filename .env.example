# Copy this file to .env and fill in your own Supabase project values.
# Supabase Dashboard -> Project Settings -> API
# Use the "anon" / publishable key only. Never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional social sign-in. Set to true ONLY after enabling the provider in Supabase
# (Authentication -> Providers) and adding the redirect URLs. See README. Buttons stay hidden otherwise.
EXPO_PUBLIC_AUTH_GOOGLE=false
EXPO_PUBLIC_AUTH_APPLE=false
